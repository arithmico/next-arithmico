{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arithmico Desktop",
  "version": "0.1.0",
  "identifier": "com.arithmico",
  "build": {
    "frontendDist": "../arithmico/dist",
    "devUrl": "http://localhost:8080/",
    "beforeDevCommand": {
      "script": "trunk serve",
      "cwd": "../arithmico"
    },
    "beforeBuildCommand": {
      "script": "trunk build --release",
      "cwd": "../arithmico"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Arithmico",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "license": "AGPL-3.0-or-later",
    "homepage": "https://arithmico.com",
    "category": "Education",
    "targets": "all",
    "icon": [
      "icons/logo192.png",
      "icons/logo512.png",
      "icons/favicon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
